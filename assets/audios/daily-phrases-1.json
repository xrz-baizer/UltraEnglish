  {"id":"daily-phrases-1-13","startTime":102.6,"endTime":110.64,"text":"Getting enough sleep has a positive effect on both our physical health and mental well-being.","words":[{"text":"Getting","startTime":102.6,"endTime":103.22},{"text":"enough","startTime":103.22,"endTime":103.58},{"text":"sleep","startTime":104.06,"endTime":104.22},{"text":"has","startTime":104.22,"endTime":104.48},{"text":"a","startTime":104.53,"endTime":104.58},{"text":"positive","startTime":104.58,"endTime":105.23},{"text":"effect","startTime":105.38,"endTime":105.76},{"text":"on","startTime":105.86,"endTime":106.02},{"text":"both","startTime":106.02,"endTime":106.3},{"text":"our","startTime":106.38,"endTime":106.54},{"text":"physical","startTime":106.68,"endTime":107.37},{"text":"health","startTime":107.37,"endTime":107.52},{"text":"and","startTime":108.09,"endTime":108.18},{"text":"mental","startTime":108.18,"endTime":108.68},{"text":"well-being.","startTime":108.73,"endTime":109.72}]},
  {"id":"daily-phrases-1-14","startTime":110.64,"endTime":121.92,"text":"Social media can have a negative effect on young people's self-esteem, especially when they constantly compare themselves with others.","words":[{"text":"Social","startTime":110.64,"endTime":111.23},{"text":"media","startTime":111.23,"endTime":111.51},{"text":"can","startTime":111.95,"endTime":112.01},{"text":"have","startTime":112.01,"endTime":112.4},{"text":"a","startTime":112.4,"endTime":112.49},{"text":"negative","startTime":112.49,"endTime":113.18},{"text":"effect","startTime":113.35,"endTime":113.71},{"text":"on","startTime":113.89,"endTime":114.06},{"text":"young","startTime":114.06,"endTime":114.55},{"text":"people's","startTime":114.55,"endTime":115.27},{"text":"self-esteem,","startTime":115.39,"endTime":116.4},{"text":"especially","startTime":116.59,"endTime":117.68},{"text":"when","startTime":117.68,"endTime":117.8},{"text":"they","startTime":117.8,"endTime":118.17},{"text":"constantly","startTime":118.17,"endTime":119.1},{"text":"compare","startTime":119.1,"endTime":119.75},{"text":"themselves","startTime":119.75,"endTime":120.67},{"text":"with","startTime":120.67,"endTime":120.89},{"text":"others.","startTime":121.48,"endTime":121.57}]},
  {"id":"daily-phrases-1-15","startTime":121.92,"endTime":130,"text":"Spending time in nature has a calming effect on me, particularly when I'm feeling stressed or overwhelmed.","words":[{"text":"Spending","startTime":121.92,"endTime":122.58},{"text":"time","startTime":122.58,"endTime":122.91},{"text":"in","startTime":122.91,"endTime":123.07},{"text":"nature","startTime":123.07,"endTime":123.2},{"text":"has","startTime":123.6,"endTime":123.82},{"text":"a","startTime":123.82,"endTime":123.83},{"text":"calming","startTime":123.92,"endTime":124.48},{"text":"effect","startTime":124.48,"endTime":124.98},{"text":"on","startTime":124.98,"endTime":125.14},{"text":"me,","startTime":125.14,"endTime":125.29},{"text":"particularly","startTime":125.75,"endTime":126.46},{"text":"when","startTime":126.46,"endTime":126.68},{"text":"I'm","startTime":126.86,"endTime":127.03},{"text":"feeling","startTime":127.03,"endTime":127.61},{"text":"stressed","startTime":127.61,"endTime":128.29},{"text":"or","startTime":128.44,"endTime":128.56},{"text":"overwhelmed.","startTime":128.56,"endTime":129.49}]},
